# The deployed platform runs the same packages/platform/src/bin.ts entrypoint as local proof.
# Supply secrets through the deployment environment; never commit their real values.
EF_OIDC_ISSUER=https://electric-forest.us.auth0.com/
EF_OIDC_CLIENT_ID=replace-with-auth0-public-client-id
EF_SESSION_SECRET=replace-with-at-least-32-random-bytes
EF_SESSION_TTL=3600
EFOREST_SERVER_URL=https://electric-forest.electric.run/
PORT=4322

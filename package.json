{
  "name": "electric-forest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "format": "prettier --write \"*.{json,yml,yaml}\" \".*.json\" \"vitest.config.ts\" \"apps/**/*.{ts,tsx,json,md,html,css}\" \"packages/**/*.{ts,tsx,json,md,yml,yaml}\" \"packages/identity/**/*.mjs\" \"tools/**/*.mjs\"",
    "format:check": "prettier --check \"*.{json,yml,yaml}\" \".*.json\" \"vitest.config.ts\" \"apps/**/*.{ts,tsx,json,md,html,css}\" \"packages/**/*.{ts,tsx,json,md,yml,yaml}\" \"packages/identity/**/*.mjs\" \"tools/**/*.mjs\"",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"tools/**/*.mjs\" \"vitest.config.ts\"",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "pretest": "pnpm --filter @eforest/identity build && pnpm --filter @eforest/platform build",
    "test": "node tools/test.mjs",
    "build": "tsc -b tsconfig.build.json && pnpm --filter @eforest/identity build && pnpm --filter @eforest/web build",
    "task-board:check": "node tools/audit_task_architecture.mjs",
    "ef": "node packages/cli/dist/src/bin.js",
    "server:serve": "node packages/server/dist/src/bin.js",
    "record:replay": "bash tools/replay/record-e2-t12.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "chokidar": "^4.0.3",
    "eslint": "^10.6.0",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.4",
    "replayio": "1.8.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "undici": "7.16.0",
    "vitest": "^4.1.10"
  }
}

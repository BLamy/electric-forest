{
  "name": "electric-forest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "format": "prettier --write \"*.{json,yml,yaml}\" \".*.json\" \"vitest.config.ts\" \"packages/**/*.{ts,json,md,yml,yaml}\" \"tools/**/*.mjs\"",
    "format:check": "prettier --check \"*.{json,yml,yaml}\" \".*.json\" \"vitest.config.ts\" \"packages/**/*.{ts,json,md,yml,yaml}\" \"tools/**/*.mjs\"",
    "lint": "eslint \"packages/**/*.ts\" \"tools/**/*.mjs\" \"vitest.config.ts\"",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "node tools/test.mjs",
    "build": "tsc -b tsconfig.build.json",
    "task-board:check": "node tools/audit_task_architecture.mjs",
    "ef": "node packages/cli/dist/src/bin.js",
    "server:serve": "node packages/server/dist/src/bin.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "chokidar": "^4.0.3",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}

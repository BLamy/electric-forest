{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist/src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "dist"],
  "references": [
    {
      "path": "../client/tsconfig.build.json"
    },
    {
      "path": "../protocol/tsconfig.build.json"
    },
    {
      "path": "../streamfs/tsconfig.build.json"
    },
    {
      "path": "../reducers/tsconfig.build.json"
    },
    {
      "path": "../platform/tsconfig.build.json"
    },
    {
      "path": "../server/tsconfig.build.json"
    },
    {
      "path": "../workspace/tsconfig.build.json"
    }
  ]
}

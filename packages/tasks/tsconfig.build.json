    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "io/**/*.ts"],
  "exclude": ["test/**/*.ts", "dist"],
  "references": [
    {
      "path": "../evidence/tsconfig.build.json"
    },
    {
      "path": "../issues/tsconfig.build.json"
    },
    {
      "path": "../protocol/tsconfig.build.json"
    },
    {
      "path": "../streamfs/tsconfig.build.json"
    },
    {
      "path": "../client/tsconfig.build.json"
    }
  ]
}
